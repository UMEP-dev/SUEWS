    },
    "optional_reference_metadata": {
      "reason": "Optional bibliographic metadata on Reference."
    },
    "optional_soil_obs_bulk_density": {
      "reason": "Optional dry fine-earth bulk density used only when converting gravimetric soil observations."
    },
    "debt_soil_non_water": {
      "owner_issue": "#2076",
      "reason": "Remaining non-water surface soil parameter without default or DOC_REQUIRED_WHEN entry (soil_density plus intermediate NonVegetatedSurfaceProperties/VegetatedSurfaceProperties mixins after PR #2080 graduated the 28 active soil fields)."
    },
    "debt_soil_water": {
      "owner_issue": "#2076",
      "reason": "Inherited SurfaceProperties soil parameter unused by water surface; needs exclusion or dedicated contract."
    },
    "debt_building_layer_soil": {
      "owner_issue": "#2076",
      "reason": "BuildingLayer soil_store_capacity has no default and no validator rule."
    },
    "debt_biogenic_co2": {
      "owner_issue": "#2309",
      "reason": "Biogenic CO2 parameter used under biogenic emissions methods (11-46), not yet in DOC_REQUIRED_WHEN."
    },
    "debt_anthro_co2": {
      "owner_issue": "#2309",
      "reason": "Anthropogenic CO2 parameter used under detailed CO2 emissions methods, not yet in DOC_REQUIRED_WHEN."
    },
    "debt_irrigation_no_default": {
      "owner_issue": "#2309",
      "reason": "Irrigation parameter with default=None and no validator contract."
    },
    "debt_lai_power": {
      "owner_issue": "#2076",
      "reason": "LAI power coefficient used when laimethod=1 (MODELLED), not yet in DOC_REQUIRED_WHEN."
    },
    "debt_ohm_coefficients": {
      "owner_issue": "#2309",
      "reason": "OHM coefficient with default=None and no validator rule."
    },
    "debt_snow_no_default": {
      "owner_issue": "#1982",
      "reason": "Snow parameter used when snow_use=1, not yet in DOC_REQUIRED_WHEN."
    },
    "debt_storage_drain_no_default": {
      "owner_issue": "#2076",
      "reason": "Surface interception/drainage parameter with default=None and no validator rule."
    },
    "cond_stebbs_shading": {
      "reason": "Listed in DOC_REQUIRED_WHEN (STEBBS_SHADING_REQUIRED_MODES); explicit value required in active shading modes via model_fields_set."
    },
    "nullable_forcing_file": {
      "reason": "Explicit null selects runtime forcing via SUEWSSimulation.update_forcing() (gh#1722); omitted defaults to 'forcing.txt'."
    },
    "nullable_facet_snow_state": {
      "reason": "SurfaceInitialState is shared by ground surfaces (default 0.0) and roof/wall facets where snowpack fields are legitimately None."
    },
    "nullable_min_res_bioco2": {
      "reason": "Remains Optional so Phase B can nullify inactive biogenic CO2 blocks (methods 0-6), while active biogenic methods reject explicit null (gh#2087)."
    },
    "nullable_optional_submodels": {
      "reason": "Optional nested sub-model or temporal profile that may be None when its governing physics option is inactive."
    },
    "debt_opt_stebbs_archetype": {
      "owner_issue": "#2309",
      "reason": "STEBBS archetype numeric field typed Optional[FlexibleRefValue] with non-None default; allows explicit null when STEBBS is inactive."
    },
    "debt_opt_stebbs_props": {
      "owner_issue": "#2309",
      "reason": "STEBBS numeric/enum field typed Optional[FlexibleRefValue] with non-None default; allows explicit null when STEBBS is inactive."
    },
    "debt_opt_surface_thresholds": {
      "owner_issue": "#2309",
      "reason": "Surface/snow threshold parameter typed Optional[FlexibleRefValue] with non-None default; explicit null bypasses DataModelBase null rejection."
    },
    "debt_opt_bioco2_enh": {
      "owner_issue": "#2309",
      "reason": "Biogenic CO2 enhancement parameter typed Optional[FlexibleRefValue] with non-None default without active-method null guard."
    },
    "debt_opt_surface_init_temp": {
      "owner_issue": "#2309",
      "reason": "SurfaceInitialState temperature typed Optional[FlexibleRefValue] with non-None default."
    },
    "debt_opt_plain_scalars": {
      "owner_issue": "#2309",
      "reason": "Plain Optional scalar/metadata field carrying a non-None default (profiles, archetype_name, legacy Conductance.ref placeholder)."
    }
  },
